# Cloudflare Pages headers. SvelteKit's static adapter copies this file
# from `static/` to the build root, where Pages reads it. Syntax:
# https://developers.cloudflare.com/pages/configuration/headers/

# Pin the wasm MIME so the streaming compiler kicks in. Pages serves
# .wasm with the right Content-Type today, but pinning documents the
# intent and protects against asset-pipeline changes.
/*.wasm
  Content-Type: application/wasm

# Vite fingerprints every file under `_app/immutable/` with a content
# hash, so changes always produce a new URL. Aggressive caching is safe
# and cuts repeat-visit latency to zero.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# `_app/env.js` and `_app/version.json` aren't fingerprinted — SvelteKit
# uses them for runtime env + version pinning, so they have to revalidate.
/_app/env.js
  Cache-Control: public, max-age=0, must-revalidate
/_app/version.json
  Cache-Control: public, max-age=0, must-revalidate

# The HTML shell pulls in the fingerprinted entry chunks by name, so it
# must never be served stale.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
